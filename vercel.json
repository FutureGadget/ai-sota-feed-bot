{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "llm-digest.com" }],
      "destination": "https://www.llm-digest.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/weekly", "destination": "/web/weekly.html" },
    { "source": "/weekly/:week", "destination": "/web/weekly.html" },
    { "source": "/daily", "destination": "/web/daily.html" },
    { "source": "/daily/:date", "destination": "/web/daily.html" },
    { "source": "/llms.txt", "destination": "/web/llms.txt" },
    { "source": "/llm-guide.txt", "destination": "/web/llm-guide.txt" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=3600" }
      ]
    }
  ],
  "functions": {
    "api/feed.js": {
      "includeFiles": "data/{processed/**,tier1/latest.json,tier1/runs_index.json,tier1/runs/**}",
      "excludeFiles": "data/{raw/**,llm/**,digest/**,health/**,cache/**,diagnostics/**,feedback/**,analysis/**}"
    },
    "api/rss.js": {
      "includeFiles": "data/{processed/**,tier1/latest.json,tier1/runs_index.json,tier1/runs/**}",
      "excludeFiles": "data/{raw/**,llm/**,digest/**,health/**,cache/**,diagnostics/**,feedback/**,analysis/**}"
    },
    "api/weekly.js": {
      "includeFiles": "data/weekly/{index,latest}.json data/weekly/*-W*.json",
      "excludeFiles": "data/weekly/input/**"
    },
    "api/daily.js": {
      "includeFiles": "data/daily/{index,latest}.json data/daily/*-*-*.json",
      "excludeFiles": "data/daily/input/**"
    },
    "api/client-config.js": {
      "excludeFiles": "data/**"
    }
  }
}
