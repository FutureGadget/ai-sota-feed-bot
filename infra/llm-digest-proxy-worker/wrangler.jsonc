{
  "name": "llm-digest-proxy-worker",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "assets.llm-digest.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-07-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}